{
  "name": "scribe-backend",
  "version": "0.1.0",
  "private": true,
  "description": "Backend for Scribe: turns transcripts into Calendar events and Reminders via Claude.",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "start": "node dist/server.js",
    "start:local": "node --env-file=.env dist/server.js",
    "dev": "node --env-file=.env --import tsx --watch src/server.ts",
    "test": "node --import tsx --test test/*.test.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.104.1",
    "express": "^4.21.2",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/express": "^4.17.23",
    "@types/node": "^22.10.0",
    "tsx": "^4.20.6",
    "typescript": "^5.7.3"
  }
}
